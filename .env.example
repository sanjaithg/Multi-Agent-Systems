# Copy this file to .env, or just export the variable. Never commit .env or put a key in code.
# The orchestrator reads the key from the environment variable LLM_API_KEY.
LLM_API_KEY=paste-your-key-here

# Default provider: Google Gemini (OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

# Other OpenAI-compatible providers work too, e.g. Groq or OpenRouter:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<model name that supports tool use>
